# Competitor dashboard — copy variable names into your real environment.
# This repository does not load a `.env` file unless you add `python-dotenv` (or use
# your hosting provider's env UI, direnv, etc.).

# Flask session signing — set in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Dashboard login (optional; if unset, defaults are admin / admin — override for shared hosts)
RADAR_USERNAME=
RADAR_PASSWORD=

# SMTP for "send report" (optional; leave blank until configured). The app uses Gmail's
# SMTP host/port in code; adjust `app.py` if you use another provider.
SMTP_SENDER=
SMTP_PASSWORD=
